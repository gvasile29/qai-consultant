# Copy this file to .env and fill in your values
# .env is gitignored — never commit real keys

MISTRAL_API_KEY=your_mistral_api_key_here
OPENROUTER_API_KEY=your_openrouter_api_key_here
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=qai-consultant

# Optional — server-side daily generation limits (usage_guard.py).
# Defaults: 100 runs/day across all users, 10 runs/day per visitor.
# QAI_GLOBAL_DAILY_RUN_LIMIT=100
# QAI_CLIENT_DAILY_RUN_LIMIT=10
